[Unit]
Description=Flora-Pi Smart Irrigation System
After=network.target mosquitto.service zigbee2mqtt.service

[Service]
Type=simple
User=cedric
WorkingDirectory=/home/cedric/planqt/backend
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
